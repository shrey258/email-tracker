{
  "manifest_version": 3,
  "name": "Email Tracker",
  "version": "0.3.0",
  "description": "Tracks opens and link clicks on emails sent from Gmail.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "identity"
  ],
  "host_permissions": [
    "https://YOUR-SERVER.example/*",
    "https://gmail.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "gmail.js",
        "toast.js",
        "own-views.js",
        "send.js",
        "stats-line.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://YOUR-DASHBOARD.example/*"
      ],
      "js": [
        "dashboard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
